 import numpy as np
 import torch
 import torch.nn as nn
@@ -58,17 +60,43 @@ def _to_pil(tensor: torch.Tensor) -> Image.Image:
     return Image.fromarray(arr.cpu().numpy(), mode="RGB")
 
 
+def _blur(x: torch.Tensor, sigma: float) -> torch.Tensor:
+    """Separable Gaussian blur, differentiable."""
+    radius = max(1, math.ceil(3 * sigma))
+    coords = torch.arange(-radius, radius + 1, dtype=x.dtype, device=x.device)
+    g = torch.exp(-(coords ** 2) / (2 * sigma ** 2))
+    g = g / g.sum()
+    channels = x.shape[1]
+    kx = g.view(1, 1, 1, -1).repeat(channels, 1, 1, 1)
+    ky = g.view(1, 1, -1, 1).repeat(channels, 1, 1, 1)
+    x = F.conv2d(F.pad(x, (radius, radius, 0, 0), mode="reflect"), kx, groups=channels)
+    return F.conv2d(F.pad(x, (0, 0, radius, radius), mode="reflect"), ky, groups=channels)
+
+
 def _augment(x: torch.Tensor, config: CloakConfig) -> torch.Tensor:
-    """Random downscale-upscale plus Gaussian noise, all differentiable.
+    """Simulate what a platform or scraper does to an upload, differentiably.
+
+    * random downscale and upscale (resizing)
+    * random Gaussian blur (smoothing, which removes fine detail)
+    * random coarse colour quantization (a rough stand-in for lossy re-encoding)
+    * random Gaussian noise
 
-    Simulates the resizing and noise that platforms and scrapers apply, so the
-    optimized perturbation has to survive them.
+    The quantization uses a straight-through estimator: the forward pass rounds, the
+    backward pass passes gradients through unchanged. This is an approximation of JPEG,
+    not a real differentiable JPEG codec, so it is not a substitute for testing on real
+    re-encoding (which the health score's Screenshot and Recompress attacks do).
     """
     _, _, h, w = x.shape
     scale = config.min_scale + (1.0 - config.min_scale) * float(torch.rand(1))
     small = (max(32, int(h * scale)), max(32, int(w * scale)))
     y = F.interpolate(x, size=small, mode="bilinear", align_corners=False, antialias=True)
     y = F.interpolate(y, size=(h, w), mode="bilinear", align_corners=False)
+    if float(torch.rand(1)) < 0.5:
+        y = _blur(y, sigma=0.3 + 1.2 * float(torch.rand(1)))
+    if float(torch.rand(1)) < 0.5:
+        levels = int(torch.randint(64, 257, (1,)))
+        quantized = torch.round(y * (levels - 1)) / (levels - 1)
+        y = y + (quantized - y).detach()                  # straight-through
     sigma = config.max_noise * float(torch.rand(1))
     return (y + sigma * torch.randn_like(y)).clamp(0, 1)
 
