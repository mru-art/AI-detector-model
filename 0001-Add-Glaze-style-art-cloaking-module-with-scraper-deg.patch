index 0000000..43b2233
--- /dev/null
+++ b/ml/masking/encoder.py
@@ -0,0 +1,78 @@
+"""Feature encoder used both to cloak an image and to score the cloak.
+
+The encoder is the SCRAM ViT-B/16 backbone with its classification head removed,
+so it returns the 768-d CLS feature for any [0, 1] RGB tensor.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torchvision.models import vit_b_16
+
+IMAGENET_MEAN = (0.485, 0.456, 0.406)
+IMAGENET_STD = (0.229, 0.224, 0.225)
+
+
+class FeatureEncoder(nn.Module):
+    """Resize to the backbone's input size, normalize, and return features.
+
+    Accepts a float tensor of shape (N, 3, H, W) with values in [0, 1]. Resizing
+    is differentiable, so gradients reach the perturbation at full resolution.
+    """
+
+    def __init__(self, backbone: nn.Module, input_size: int = 224) -> None:
+        super().__init__()
+        self.backbone = backbone
+        self.input_size = input_size
+        self.register_buffer("mean", torch.tensor(IMAGENET_MEAN).view(1, 3, 1, 1))
+        self.register_buffer("std", torch.tensor(IMAGENET_STD).view(1, 3, 1, 1))
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = F.interpolate(
+            x,
+            size=(self.input_size, self.input_size),
+            mode="bilinear",
+            align_corners=False,
+            antialias=True,
+        )
+        return self.backbone((x - self.mean) / self.std)
+
+
+def load_scram_encoder(checkpoint_path: str | Path, device: str = "cpu") -> FeatureEncoder:
+    """Load a SCRAM checkpoint (vision_transformer/models.py layout) as a feature encoder.
+
+    Expects the torchvision ViT-B/16 layout with the custom head
+    (heads.head.0 / .3 / .6). Accepts a raw state dict or a dict holding one under
+    ``model_state_dict``, ``state_dict`` or ``model``.
+    """
+    state = torch.load(checkpoint_path, map_location="cpu", weights_only=True)
+    if isinstance(state, dict):
+        for key in ("model_state_dict", "state_dict", "model"):
+            if key in state and isinstance(state[key], dict):
+                state = state[key]
+                break
+    state = {
+        k.removeprefix("module.").removeprefix("model."): v for k, v in state.items()
+    }
+
+    if "heads.head.6.weight" not in state:
+        raise ValueError(
+            "Checkpoint does not match the SCRAM ViT head layout (heads.head.6.weight missing)"
+        )
+    num_classes = state["heads.head.6.weight"].shape[0]
+
+    model = vit_b_16(weights=None)
+    in_features = model.heads.head.in_features
+    model.heads.head = nn.Sequential(
+        nn.Linear(in_features, 512), nn.GELU(), nn.Dropout(0.4),
+        nn.Linear(512, 256), nn.GELU(), nn.Dropout(0.3),
+        nn.Linear(256, num_classes),
+    )
+    model.load_state_dict(state, strict=True)
+    model.heads.head = nn.Identity()  # keep the 768-d features, drop the classifier
+
+    return FeatureEncoder(model).to(device).eval()
diff --git a/ml/masking/health.py b/ml/masking/health.py
new file mode 100644
index 0000000..231c1c4
--- /dev/null
+++ b/ml/masking/health.py
@@ -0,0 +1,148 @@
+"""Scraper-degradation health score for a cloaked image.
+
+For each simulated scraper, we ask how much of the cloak's feature shift survives the
+scraper's preprocessing. The shift is measured in the encoder's feature space, not in
+pixels. A scraper that trains on the image sees features that are still displaced,
+so its ability to use the image is degraded.
+
+Score = 100 * mean over attackers of the retained fraction, where for each attacker
+
+    retained = (disp(attacked cloak) - disp(attacked clean)) / disp(cloak)
+
+and disp(v) = 1 - cos(f(v), f(original)), clipped to [0, 1].
+  100 = every attack keeps the full shift; 0 = every attack removes it.
+
+Limits: the attackers are fixed preprocessors (download, screenshot/JPEG, blur+JPEG,
+median denoise, downscale-upscale), not learned scrapers. This module has no dependency on
+backend/services/scraper_eval. The shift is measured with the same encoder that produced the
+cloak, so the score is a white-box upper bound on protection against unseen models.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+import io
+
+import numpy as np
+from PIL import Image, ImageFilter
+
+from .cloak import _to_tensor
+
+
+class _Identity:
+    """Scraper that downloads the file unchanged."""
+
+    def attack(self, image: Image.Image) -> Image.Image:
+        return image.convert("RGB").copy()
+
+
+class _Screenshot:
+    """Render at a 1280x720 viewport, then re-encode as JPEG q85 at the original size."""
+
+    def attack(self, image: Image.Image) -> Image.Image:
+        img = image.convert("RGB")
+        scale = min(1280 / img.width, 720 / img.height, 1.0)
+        size = (max(1, round(img.width * scale)), max(1, round(img.height * scale)))
+        canvas = img.resize(size, Image.Resampling.LANCZOS).resize(img.size, Image.Resampling.BICUBIC)
+        return _jpeg(canvas, 85)
+
+
+class _Recompress:
+    """Blur, downscale by 0.75, restore, JPEG q70."""
+
+    def attack(self, image: Image.Image) -> Image.Image:
+        img = image.convert("RGB").filter(ImageFilter.GaussianBlur(radius=0.6))
+        small = img.resize((max(1, round(img.width * 0.75)), max(1, round(img.height * 0.75))),
+                           Image.Resampling.LANCZOS)
+        return _jpeg(small.resize(img.size, Image.Resampling.BICUBIC), 70)
+
+
+class _Denoise:
+    """Median filter, a scraper's standard noise-removal step."""
+
+    def attack(self, image: Image.Image) -> Image.Image:
+        return image.convert("RGB").filter(ImageFilter.MedianFilter(size=3))
+
+
+class _Reconstruct:
+    """Downscale to 25% and upscale: a stand-in for an autoencoder bottleneck."""
+
+    def attack(self, image: Image.Image) -> Image.Image:
+        img = image.convert("RGB")
+        small = img.resize((max(1, round(img.width * 0.25)), max(1, round(img.height * 0.25))),
+                           Image.Resampling.BOX)
+        return small.resize(img.size, Image.Resampling.BICUBIC)
+
+
+def _jpeg(image: Image.Image, quality: int) -> Image.Image:
+    buf = io.BytesIO()
+    image.save(buf, format="JPEG", quality=quality)
+    buf.seek(0)
+    with Image.open(buf) as out:
+        return out.convert("RGB").copy()
+
+
+DEFAULT_ATTACKERS = (
+    ("Identity", _Identity),
+    ("Screenshot", _Screenshot),
+    ("Recompress", _Recompress),
+    ("Denoise", _Denoise),
+    ("Reconstruct", _Reconstruct),
+)
+
+
+@dataclass(frozen=True)
+class HealthReport:
+    score: float                       # 0-100, higher = scraper more degraded
+    per_attacker: dict[str, float] = field(default_factory=dict)
+    cloak_shift: float = 0.0           # 1 - cos of cloaked vs original, before attacks
+
+    @property
+    def worst_attacker(self) -> tuple[str, float]:
+        name = min(self.per_attacker, key=self.per_attacker.get)
+        return name, self.per_attacker[name]
+
+
+def _features(encoder: nn.Module, image: Image.Image, device: str) -> torch.Tensor:
+    with torch.no_grad():
+        return encoder(_to_tensor(image, device))
+
+
+def _displacement(a: torch.Tensor, b: torch.Tensor) -> float:
+    return float(1.0 - F.cosine_similarity(a, b).mean())
+
+
+def protection_health(
+    original: Image.Image,
+    cloaked: Image.Image,
+    encoder: nn.Module,
+    device: str = "cpu",
+) -> HealthReport:
+    """Score how much the cloak's feature shift survives each simulated scraper."""
+    if original.size != cloaked.size:
+        raise ValueError("original and cloaked must have the same size")
+
+    encoder = encoder.to(device).eval()
+    f_orig = _features(encoder, original, device)
+    f_cloak = _features(encoder, cloaked, device)
+    nominal = _displacement(f_cloak, f_orig)
+
+    if nominal < 1e-6:
+        return HealthReport(score=0.0, per_attacker={}, cloak_shift=0.0)
+
+    per_attacker: dict[str, float] = {}
+    for name, attacker_cls in DEFAULT_ATTACKERS:
+        attacker = attacker_cls()
+        f_attacked_cloak = _features(encoder, attacker.attack(cloaked), device)
+        f_attacked_clean = _features(encoder, attacker.attack(original), device)
+        shift_kept = _displacement(f_attacked_cloak, f_orig) - _displacement(
+            f_attacked_clean, f_orig
+        )
+        per_attacker[name] = round(100.0 * min(max(shift_kept / nominal, 0.0), 1.0), 2)
+
+    score = round(sum(per_attacker.values()) / len(per_attacker), 2)
+    return HealthReport(score=score, per_attacker=per_attacker, cloak_shift=nominal)
diff --git a/tests/test_masking.py b/tests/test_masking.py
new file mode 100644
index 0000000..08c08ab
--- /dev/null
+++ b/tests/test_masking.py
@@ -0,0 +1,105 @@
+import numpy as np
+import pytest
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from PIL import Image
+
+from ml.masking.cloak import CloakConfig, _to_tensor, cloak, image_ssim
+from ml.masking.encoder import FeatureEncoder
+from ml.masking.health import protection_health
+
+
+class TinyEncoder(nn.Module):
+    """Stand-in backbone: 2 convs + pooling. Mechanics only, not the SCRAM model."""
+
+    def __init__(self):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Conv2d(3, 16, 3, stride=2, padding=1), nn.ReLU(),
+            nn.Conv2d(16, 32, 3, stride=2, padding=1), nn.ReLU(),
+            nn.AdaptiveAvgPool2d(1), nn.Flatten(),
+        )
+
+    def forward(self, x):
+        return self.net(x)
+
+
+@pytest.fixture(scope="module")
+def encoder():
+    torch.manual_seed(0)
+    return FeatureEncoder(TinyEncoder(), input_size=64).eval()
+
+
+@pytest.fixture
+def artwork():
+    rng = np.random.default_rng(1)
+    arr = rng.integers(0, 256, size=(96, 96, 3), dtype=np.uint8)
+    return Image.fromarray(arr, mode="RGB")
+
+
+def _cos(encoder, a, b):
+    with torch.no_grad():
+        fa = encoder(_to_tensor(a, "cpu"))
+        fb = encoder(_to_tensor(b, "cpu"))
+        return float(F.cosine_similarity(fa, fb).mean())
+
+
+def test_budget_is_respected(encoder, artwork):
+    eps = 8 / 255
+    out = cloak(artwork, encoder, CloakConfig(epsilon=eps, steps=20, min_ssim=0.0))
+    diff = np.abs(np.asarray(out, np.float32) - np.asarray(artwork, np.float32)) / 255.0
+    assert diff.max() <= eps + 1 / 255 + 1e-6
+
+
+def test_untargeted_cloak_moves_features_away(encoder, artwork):
+    out = cloak(artwork, encoder, CloakConfig(epsilon=8 / 255, steps=40, min_ssim=0.0))
+    assert _cos(encoder, out, artwork) < 0.999
+
+
+def test_targeted_cloak_moves_toward_decoy(encoder, artwork):
+    torch.manual_seed(0)
+    rng = np.random.default_rng(7)
+    decoy = Image.fromarray(rng.integers(0, 256, (96, 96, 3), dtype=np.uint8))
+    before = _cos(encoder, artwork, decoy)
+    out = cloak(artwork, encoder, CloakConfig(epsilon=8 / 255, steps=80, min_ssim=0.0, robust=False), decoy=decoy)
+    assert _cos(encoder, out, decoy) > before
+
+
+def test_zero_budget_is_identity(encoder, artwork):
+    out = cloak(artwork, encoder, CloakConfig(epsilon=0.0, steps=10, min_ssim=0.5))
+    assert np.array_equal(np.asarray(out), np.asarray(artwork))
+
+
+def test_ssim_floor_is_enforced(encoder, artwork):
